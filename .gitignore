# Dependencies and Expo output
node_modules/
.expo/
dist/
web-build/
*.log

# Native directories generated by Expo prebuild
/ios/
/android/

# Xcode user state and build artifacts (also for watchos/)
**/DerivedData/
**/build/
**/*.xcuserstate
**/xcuserdata/
**/*.xcworkspace/xcuserdata/
*.ipa
*.app
*.dSYM/
*.dSYM.zip

# Generated watchOS Xcode project (regenerate from watchos/project.yml)
/watchos/*.xcodeproj/
/watchos/*.xcworkspace/

# Environment and local secrets
.env
.env.*
!.env.example
!.env.sample

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/

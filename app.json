{
  "expo": {
    "name": "MoodPals",
    "icon": "./assets/branding/app-icon.png",
    "slug": "superdotspals",
    "scheme": "wellnest",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superdotspals.wellnest",
      "appleTeamId": "Y355786FS4",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Allow MoodPals to read heart rate variability, heart rate, resting heart rate, sleep, activity, daylight, mindful minutes and noise levels to estimate your stress and energy.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "MoodPals uses Face ID to confirm changes to family devices.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSHealthUpdateUsageDescription": "MoodPals reads your health data for wellness insights and does not write to Apple Health.",
        "NSLocationWhenInUseUsageDescription": "MoodPals shows your family watch's last location on a map. The iPhone app does not use your own location."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.superdotspals.wellnest"
        ],
        "com.apple.developer.family-controls": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.superdotspals.wellnest",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Allow MoodPals to read heart rate variability, heart rate, resting heart rate, sleep, activity, daylight, mindful minutes and noise levels to estimate your stress and energy.",
          "healthUpdatePermission": false,
          "isBackgroundDeliveryEnabled": true,
          "healthConnectPermissions": [
            "READ_STEPS",
            "READ_HEART_RATE",
            "READ_SLEEP",
            "READ_HEALTH_DATA_HISTORY"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@bacons/apple-targets",
      "./scripts/with-watch-widget-embed.cjs",
      "./scripts/with-health-privacy.cjs",
      "./scripts/with-scene-lifecycle.cjs",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-maps",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "MoodPals uses the microphone so you can talk with your MoodPal."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7fce274d-e6b2-4944-a9b0-ef08fa13f871"
      }
    },
    "owner": "carlosnvr422"
  }
}

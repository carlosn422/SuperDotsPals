{
  "expo": {
    "name": "MoodPals",
    "icon": "./assets/branding/app-icon.png",
    "slug": "superdotspals",
    "scheme": "wellnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superdotspals.wellnest",
      "appleTeamId": "Y355786FS4",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Allow MoodPals to read heart rate variability, heart rate, resting heart rate, sleep, activity, daylight, mindful minutes and noise levels to estimate your stress and energy.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthUpdateUsageDescription": "MoodPals reads your health data for wellness insights and does not write to Apple Health."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.superdotspals.wellnest"
        ]
      }
    },
    "android": {
      "package": "com.superdotspals.wellnest",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "Allow MoodPals to read heart rate variability, heart rate, resting heart rate, sleep, activity, daylight, mindful minutes and noise levels to estimate your stress and energy.",
          "healthUpdatePermission": false,
          "isBackgroundDeliveryEnabled": true,
          "healthConnectPermissions": [
            "READ_STEPS",
            "READ_HEART_RATE",
            "READ_SLEEP",
            "READ_HEALTH_DATA_HISTORY"
          ]
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      "@bacons/apple-targets",
      "./scripts/with-watch-widget-embed.cjs",
      "./scripts/with-health-privacy.cjs",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "7fce274d-e6b2-4944-a9b0-ef08fa13f871"
      }
    },
    "owner": "carlosnvr422"
  }
}
